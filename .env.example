# ============================================================
# RetentionAI API — Environment Configuration (Template)
# ============================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# DO NOT commit the real .env file — it is git-ignored.
# In production, inject secrets via a secrets manager, not .env.
# ============================================================

# --- Application ---
# production | staging | development
ENVIRONMENT=production

# --- API Server ---
# Host interface to bind inside the container.
API_HOST=0.0.0.0
# Host port mapped to the container's 8000 (see docker-compose.yml ports).
API_PORT=8000

# --- Logging ---
# Python logging level: debug | info | warning | error | critical
LOG_LEVEL=info

# --- Model Artifacts ---
# Directory (inside the container) where model artifacts are stored.
ARTIFACTS_DIR=artifacts

# --- Docker Image ---
# Tag applied to the built image (e.g. latest, v1.0.0).
IMAGE_TAG=latest
